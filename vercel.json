{
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog/index.html"
    },
    {
      "source": "/:nome(comandos|celulares|mesa)",
      "destination": "/p/index.html"
    },
    {
      "source": "/:nome(comandos|celulares|mesa)/",
      "destination": "/p/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "site-beta-six-19.vercel.app"
        }
      ],
      "destination": "https://www.adrianoarruda.com/$1",
      "permanent": true
    }
  ]
}
